# AI provider — set one. OPENAI_API_KEY takes priority if both are set (see src/lib/ai/provider.ts)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Transactional email
RESEND_API_KEY=
SMTP_HOST=
SMTP_EMAIL=
SMTP_PASSWORD=
