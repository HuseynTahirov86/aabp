rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && (getUserRole() == "ADMIN" || getUserRole() == "SUPER_ADMIN");
    }
    
    function isEditor() {
      return isAuthenticated() && (getUserRole() == "EDITOR" || getUserRole() == "ADMIN" || getUserRole() == "SUPER_ADMIN");
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || (isAuthenticated() && resource.data.publicProfile == true) || (isAuthenticated() && resource.data.role == "COMMITTEE");
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Events Collection
    match /events/{eventId} {
      allow read: if (resource == null) || (resource.data.status == "Published") || isEditor(); 
      allow write: if isEditor();
    }

    // Event Registrations
    match /event_registrations/{registrationId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || isEditor());
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow update, delete: if isEditor();
    }

    // Jobs Collection
    match /jobs/{jobId} {
      allow read: if (resource == null) || (resource.data.status == "Published") || isEditor();
      allow write: if isEditor();
    }

    // Articles Collection
    match /articles/{articleId} {
      allow read: if (resource == null) || (resource.data.status == "Published") || isEditor();
      allow write: if isEditor();
    }

    // Research Collection
    match /research/{researchId} {
      // Research items are strictly published
      allow read: if (resource == null) || (resource.data.status == "Published") || isEditor();
      allow write: if isEditor();
    }

    // Projects Collection
    match /projects/{projectId} {
      allow read: if (resource == null) || (resource.data.status == "Published") || isEditor();
      allow write: if isEditor();
    }

    // Forum — open discussion board, public read, members can post
    match /forum_topics/{topicId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      // Reply creation bumps replyCount/lastReplyAt on the topic doc, so any
      // authenticated member may update it (not just the original author).
      allow update: if isAuthenticated();
      allow delete: if isOwner(resource.data.authorId) || isAdmin();
    }

    match /forum_replies/{replyId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.authorId) || isAdmin();
    }

    // Resource Library — member-only reading, editor/admin manage uploads
    match /resources/{resourceId} {
      allow read: if isAuthenticated();
      allow write: if isEditor();
    }

    // Member-to-member connections
    match /connections/{connectionId} {
      allow read: if isAuthenticated() &&
        (request.auth.uid == resource.data.fromUserId || request.auth.uid == resource.data.toUserId);
      allow create: if isAuthenticated() && request.resource.data.fromUserId == request.auth.uid;
      // Only the recipient can accept/reject a pending request.
      allow update: if isAuthenticated() && request.auth.uid == resource.data.toUserId;
      allow delete: if isAdmin();
    }

    // Mentorship — member-only directory and requests
    match /mentorship_profiles/{profileId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /mentorships/{mentorshipId} {
      allow read: if isAuthenticated() &&
        (request.auth.uid == resource.data.mentorId || request.auth.uid == resource.data.menteeId);
      allow create: if isAuthenticated() && request.resource.data.menteeId == request.auth.uid;
      // The mentor accepts/rejects; either side can mark it ended.
      allow update: if isAuthenticated() &&
        (request.auth.uid == resource.data.mentorId || request.auth.uid == resource.data.menteeId);
      allow delete: if isAdmin();
    }
  }
}
